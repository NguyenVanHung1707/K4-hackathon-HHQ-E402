# =====================================================================
# 🎓 VLearn EduAI — Cấu Hình Biến Môi Trường (Environment Variables)
# =====================================================================

# 1. API Key của OpenAI (Dùng để gọi LLM sinh bài tập & chấm tự luận chuẩn hóa)
# Lấy key tại: https://platform.openai.com/api-keys
# 💡 LƯU Ý: Nếu để trống key, hệ thống vẫn hoạt động 100% bình thường bằng Fallback RAG Engine mà KHÔNG tốn tiền API!
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# 2. API Key của Google Gemini (Tùy chọn nếu dùng mô hình Gemini)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 3. Tên Mô Hình LLM Sử Dụng (Mặc định: gpt-4o-mini hoặc gpt-4o)
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0

# 4. Độ Liều / Sáng Tạo Của LLM (Mặc định 0.2 để bài tập bám sát bài giảng)
TEMPERATURE=0.2

# 5. Đường Dẫn Lưu Trữ Dữ Liệu (Mặc định dùng thư mục local trong project)
CHROMA_DB_DIR=./data/chroma
SQLITE_DB_PATH=./data/db/vlearn.db
